Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    # RNF-02: NO se incluye ningún display de imagen. RViz no debe suscribirse
    # al flujo de vídeo del menor; si se añadiera, privacy_guard_node lo
    # detectaría como suscriptor no autorizado y solicitaría la parada segura.
    # La supervisión clínica se hace sobre el estado de la FSM y el índice de
    # malestar, no sobre la imagen.
    - Class: rviz_default_plugins/Marker
      Name: LED
      Topic:
        Value: /pedcom/actuation/led_marker
      Enabled: true
  Global Options:
    Fixed Frame: base_link
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.6
Window Geometry:
  Height: 800
  Width: 1200
